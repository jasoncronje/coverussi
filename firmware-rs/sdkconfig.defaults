CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
# N32R16: octal PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# GPIO43/44 (UART0) carry I2S BCLK and SD CMD on this board, so the console
# is the USB Serial/JTAG port.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_LWIP_MAX_SOCKETS=16
# Big buffers (clips, downloads, decoded art) go to PSRAM.
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# The panel's DMA buffers take about 160 KB of internal RAM; thread stacks need
# the rest, so Wi-Fi, lwIP and TLS buffers go to PSRAM.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# Hardware AES wants DMA bounce buffers in internal RAM for PSRAM data, and
# there's none to spare: every TLS read failed. Software AES is fast enough.
CONFIG_MBEDTLS_HARDWARE_AES=n
# A recognition's signature keeps CPU 1 busy for several seconds; that's
# expected, not a hang.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
# Rust's std threads and event loop want more stack than C's defaults.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192
# The web app's live feed.
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=1024
CONFIG_LWIP_LOCAL_HOSTNAME="coverussi"
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="0.1.1"
# esp-idf-hal links the legacy I2C driver, unused; the mic's codec uses i2c_master.
CONFIG_I2C_SKIP_LEGACY_CONFLICT_CHECK=y
