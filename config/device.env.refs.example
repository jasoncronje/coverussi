# Copy to config/device.env.refs for scripts/provision.py. Values may be
# 1Password references (op://...), resolved by `op run`.
WIFI_SSID=op://<vault>/<item>/ssid
WIFI_PASSWORD=op://<vault>/<item>/password
HA_URL=https://homeassistant.local:8123
HA_TOKEN=op://<vault>/<item>/token
# Optional: resolve the HA host to this LAN address (TLS still checks HA_URL's name)
HA_CONNECT_IP=
# Optional: Home Assistant's MQTT discovery (what the display hears, the panel as a light)
MQTT_URL=mqtt://user:password@homeassistant.local
